#!/bin/bash

# omarchy:summary=Enumerate desktop apps for the Walker inventory launcher
# omarchy:hidden=true

# Emits one TSV record per visible application:
#   id <TAB> name <TAB> subtext <TAB> icon <TAB> preview.png
#
# The same records are written to a manifest file, which is what the elephant
# lua provider actually reads. The provider runs on every keystroke and its lua
# state is destroyed between calls, so it cannot memoise anything itself and
# cannot afford to fork this script per keypress; reading the manifest costs
# nothing. `--sync` refreshes the manifest without printing it, and returns
# immediately when nothing has changed.
#
# Also renders the detail-panel image for each app. A walker/elephant preview is
# either text OR a file, never both, so showing the icon beside the name and
# description means compositing them into a single PNG. Results are cached per
# theme (the text is drawn in the theme's foreground colour) and only rendered
# when missing, so this costs ~10ms per new app and nothing on later runs.

set -uo pipefail

THEME=$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || echo default)
COLORS="$HOME/.config/omarchy/current/theme/colors.toml"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/walker-app-previews/$THEME"
# Slot icons are theme-independent, so they live outside the per-theme cache.
ICON_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/walker-app-icons"
MANIFEST="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/walker-app-entries.tsv"
MODE=${1:-}
# Anything rendered before this script was last edited is stale: the icon sizes
# and the panel layout below are baked into the cached PNGs, so changing them
# has to invalidate the cache or the edit appears to do nothing.
SELF=${BASH_SOURCE[0]}
# The rendered icon canvas is also the slot's content box. Walker's ItemBox
# fills its grid cell and left-aligns the image inside it, and neither halign
# nor an extra wrapper widget can change that (walker rebuilds each item and
# drops widgets it does not know). Making the canvas square and letting it fill
# the content box is what centres the glyph: the slot ends up
# ICON_PX + 30px frame + 6px padding on both axes, so it is square too.
ICON_PX=39
GLYPH_PX=26

# Detail-panel geometry. The panel is as wide as the grid (516px, pinned in
# layout.xml) less its 15px nine-patch frame a side. Walker's preview stack
# requests 300px of height regardless, so the canvas keeps that height and the
# theme clips it; see render_preview.
PANEL_W=486
PANEL_H=300
# Text is drawn to the right of the 62px icon, leaving PANEL_W - 96 for it.
# This monospace font advances about 0.46 * pointsize per character, so at 20pt
# that is ~35 columns and at 16pt ~44.
NAME_COLS=42
DESC_COLS=53
DESC_LINES=2
mkdir -p "$CACHE" "$ICON_CACHE"

# Serialise. Both omarchy-theme-set and every elephant query call this, so a
# theme switch can otherwise start several cold runs at once; they then all
# rebuild the icon index and render the same files, which is far slower than
# doing it once. Callers queue instead, and everyone after the first finds a
# warm cache and returns in well under a second.
# A rebuild is only needed when the set of .desktop files changed (both dirs'
# mtimes move on add/remove) or when the theme changed (previews are rendered in
# the theme's colours, so they live in a per-theme cache). Checked before taking
# the lock so the common "nothing changed" case never waits on a running build.
is_fresh() {
  [[ -s $MANIFEST ]] || return 1
  local m t ref
  m=$(stat -c %Y "$MANIFEST" 2>/dev/null) || return 1
  for ref in /usr/share/applications "$HOME/.local/share/applications" \
             "$HOME/.config/omarchy/current/theme.name" "$SELF"; do
    [[ -e $ref ]] || continue
    t=$(stat -c %Y "$ref" 2>/dev/null) || continue
    (( t > m )) && return 1
  done
  return 0
}

[[ $MODE == --sync ]] && is_fresh && exit 0

LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-walker-app-entries.lock"
exec 9>"$LOCK" || true
flock 9 2>/dev/null || true

# Another queued run may have rebuilt it while this one waited for the lock.
[[ $MODE == --sync ]] && is_fresh && exit 0

read_color() {
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "$COLORS" 2>/dev/null | head -1
}
FG=$(read_color foreground); FG=${FG:-#cccccc}
AC=$(read_color accent);     AC=${AC:-$FG}
FONT=$(fc-match monospace --format='%{file}' 2>/dev/null)

# Name -> file index for icon themes, preferring larger rasters. Built lazily:
# scanning the icon dirs costs ~2s, and it is only needed when a preview is
# missing from the cache, which is rare after the first run.
declare -A ICON
ICON_INDEXED=0
build_icon_index() {
  (( ICON_INDEXED )) && return 0
  ICON_INDEXED=1
  while IFS= read -r p; do
    b=${p##*/}; b=${b%.*}
    case "$p" in
      */512x512/*|*/256x256/*) s=6 ;;
      */128x128/*)             s=5 ;;
      */scalable/*)            s=4 ;;
      */96x96/*|*/64x64/*)     s=3 ;;
      */48x48/*)               s=2 ;;
      *)                       s=1 ;;
    esac
    prev=${ICON[$b]:-}
    if [[ -z $prev || ${prev%%:*} -lt $s ]]; then ICON[$b]="$s:$p"; fi
  done < <(find -L /usr/share/icons "$HOME/.local/share/icons" /usr/share/pixmaps \
             -type f \( -name '*.png' -o -name '*.svg' -o -name '*.xpm' \) 2>/dev/null)
}

# Sets RESOLVED_ICON rather than echoing. Echoing would mean calling this in a
# command substitution, which runs in a subshell -- and that discards both the
# memoised icon index and the ICON_INDEXED flag, so the index gets rebuilt once
# per app instead of once per run.
RESOLVED_ICON=""
resolve_icon() {
  local ic=$1
  RESOLVED_ICON=""
  [[ -z $ic ]] && return 1
  if [[ $ic == /* && -f $ic ]]; then RESOLVED_ICON=$ic; return 0; fi
  build_icon_index
  local e=${ICON[$ic]:-}
  [[ -n $e ]] && { RESOLVED_ICON=${e#*:}; return 0; }
  return 1
}

# Normalise every icon to a square PNG at exactly the slot's display size.
# Icons that resolve to a file path (rather than an icon-theme name) ignore
# GtkImage's pixel-size and render at their own aspect - a 709x512 app icon comes
# out ~39px wide. GtkGridView then sizes every column to the widest item, which
# makes the whole grid rectangular and throws the icons off-centre. Pre-squaring
# them removes the variable entirely.
square_icon() {
  local out=$1 src=$2
  [[ -f $out && $out -nt $SELF ]] && return 0
  [[ -n $src && -f $src ]] || return 1
  magick "$src" -background none -resize "${GLYPH_PX}x${GLYPH_PX}" \
    -gravity center -extent "${ICON_PX}x${ICON_PX}" "$out" 2>/dev/null
}

# Truncates to $2 characters, keeping room for the ellipsis.
ellipsize() {
  local text=$1 max=$2
  if (( ${#text} > max )); then printf '%s...' "${text:0:max-3}"; else printf '%s' "$text"; fi
}

render_preview() {
  local out=$1 iconfile=$2 name=$3 desc=$4
  [[ -f $out && $out -nt $SELF ]] && return 0
  # Trim for display only; the untruncated name is what gets searched.
  name=$(ellipsize "$name" "$NAME_COLS")
  desc=$(ellipsize "$desc" $((DESC_COLS * DESC_LINES)))
  # Walker's preview stack is ~300px tall and cannot be shrunk from a theme, so
  # the panel is clipped to a short strip by PreviewClip in layout.xml. The image
  # is therefore rendered at the stack's own proportions with everything drawn in
  # the top band and the rest left transparent: that way the content lands at the
  # top of the stack and stays inside the visible strip, with no CSS margin hacks.
  local args=(-size "${PANEL_W}x${PANEL_H}" xc:none)
  if [[ -n $iconfile && -f $iconfile ]]; then
    args+=(\( "$iconfile" -background none -resize 62x62 \) -gravity northwest -geometry +10+12 -composite)
  fi
  args+=(-font "$FONT"
         -fill "$AC" -pointsize 13 -gravity northwest -annotate +86+10 "Name:"
         -fill "$FG" -pointsize 20 -gravity northwest -annotate +86+34 "$name"
         -fill "$AC" -pointsize 13 -gravity northwest -annotate +86+66 "Description:")
  # -annotate does not wrap, so fold by hand and stack the lines. Two lines at
  # this width hold more text than the single line the old wide panel did.
  local y=90 line
  while IFS= read -r line; do
    args+=(-fill "$FG" -pointsize 16 -gravity northwest -annotate "+86+$y" "$line")
    y=$((y + 22))
  done < <(printf '%s\n' "$desc" | fold -s -w "$DESC_COLS" | head -n "$DESC_LINES")
  magick "${args[@]}" "$out" 2>/dev/null
}

shopt -s nullglob
for d in /usr/share/applications "$HOME/.local/share/applications"; do
  [[ -d $d ]] || continue
  for f in "$d"/*.desktop; do
    grep -q '^NoDisplay=true' "$f" && continue
    grep -q '^Type=Application' "$f" || continue
    id=$(basename "$f" .desktop)
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    [[ -n $name ]] || continue
    comment=$(grep -m1 '^Comment=' "$f" | cut -d= -f2-)
    generic=$(grep -m1 '^GenericName=' "$f" | cut -d= -f2-)
    icon=$(grep -m1 '^Icon=' "$f" | cut -d= -f2-)

    sub=${generic:-$comment}
    desc=${comment:-$generic}
    [[ -n $desc ]] || desc="No description available."

    preview="$CACHE/$id.png"
    square="$ICON_CACHE/$id.png"
    if [[ ! -f $preview || ! -f $square || $preview -ot $SELF || $square -ot $SELF ]]; then
      resolve_icon "$icon"
      render_preview "$preview" "$RESOLVED_ICON" "$name" "$desc"
      square_icon "$square" "$RESOLVED_ICON"
    fi
    # fall back to the raw icon name if squaring failed
    [[ -f $square ]] && icon=$square
    [[ -f $preview ]] || preview=""

    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$sub" "$icon" "$preview"
  done
done | sort -u -t"$(printf '\t')" -k2,2 >"$MANIFEST.$$"

if [[ -s $MANIFEST.$$ ]]; then
  mv -f "$MANIFEST.$$" "$MANIFEST"
else
  # Never replace a good manifest with an empty one (e.g. a failed render run).
  rm -f "$MANIFEST.$$"
fi

[[ $MODE == --sync ]] || cat "$MANIFEST" 2>/dev/null
