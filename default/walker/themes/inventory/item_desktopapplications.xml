<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <!-- Icon-only slot. The name and description live in the detail panel, so the
       ItemText/ItemSubtext labels are omitted entirely rather than hidden with
       CSS - a collapsed label still takes part in the box's centring and pushes
       the icon off-centre. -->
  <object class="GtkBox" id="ItemBox">
    <style>
      <class name="item-box"></class>
    </style>
    <property name="orientation">vertical</property>
    <property name="halign">fill</property>
    <property name="valign">fill</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkImage" id="ItemImage">
        <style>
          <class name="item-image"></class>
        </style>
        <property name="pixel-size">24</property>
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
      </object>
    </child>
  </object>
</interface>
