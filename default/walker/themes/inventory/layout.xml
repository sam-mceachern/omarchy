<?xml version="1.0" encoding="UTF-8"?>
<!-- Walker "inventory" launcher layout.

     Structure: search on top, then the detail panel with the open button
     floating over its bottom-right corner (GtkOverlay), then the icon grid.

     Walker locates its widgets by id, not by position, so the panel and the
     keybind buttons can be re-parented freely as long as the ids survive. -->
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkWindow" id="Window">
    <style>
      <class name="window"></class>
    </style>
    <property name="resizable">true</property>
    <property name="title">Walker</property>
    <child>
      <object class="GtkBox" id="BoxWrapper">
        <style>
          <class name="box-wrapper"></class>
        </style>
        <property name="width-request">920</property>
        <property name="overflow">hidden</property>
        <property name="orientation">horizontal</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkBox" id="Box">
            <style>
              <class name="box"></class>
            </style>
            <property name="orientation">vertical</property>
            <property name="hexpand-set">true</property>
            <property name="hexpand">true</property>
            <property name="spacing">8</property>

            <child>
              <object class="GtkBox" id="SearchContainer">
                <style>
                  <class name="search-container"></class>
                </style>
                <property name="overflow">hidden</property>
                <property name="orientation">horizontal</property>
                <property name="halign">fill</property>
                <property name="hexpand-set">true</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkEntry" id="Input">
                    <style>
                      <class name="input"></class>
                    </style>
                    <property name="halign">fill</property>
                    <property name="hexpand-set">true</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkOverlay" id="PreviewOverlay">
                <property name="hexpand">true</property>
                <property name="vexpand">false</property>
                <property name="valign">start</property>
                <!-- Walker nests its own PreviewBox inside this one, and that
                     embedded widget requests height 300. height-request is a
                     floor and GTK CSS has no max-height, so the only way to cap
                     the panel is to clip it: a GtkScrolledWindow with
                     max-content-height and no visible scrollbars. -->
                <child>
                  <object class="GtkScrolledWindow" id="PreviewClip">
                    <style>
                      <class name="preview-clip"></class>
                    </style>
                    <property name="hexpand">true</property>
                    <property name="vexpand">false</property>
                    <property name="valign">start</property>
                    <property name="max-content-height">150</property>
                    <property name="min-content-height">150</property>
                    <property name="propagate-natural-height">false</property>
                    <property name="vscrollbar-policy">external</property>
                    <property name="hscrollbar-policy">external</property>
                    <child>
                      <object class="GtkBox" id="Preview">
                        <style>
                          <class name="preview"></class>
                        </style>
                        <property name="hexpand">true</property>
                        <property name="valign">start</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkBox" id="Keybinds">
                    <style>
                      <class name="keybinds"></class>
                    </style>
                    <property name="halign">end</property>
                    <property name="valign">end</property>
                    <child>
                      <object class="GtkBox" id="GlobalKeybinds">
                        <property name="spacing">6</property>
                        <style>
                          <class name="global-keybinds"></class>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="ItemKeybinds">
                        <property name="spacing">6</property>
                        <style>
                          <class name="item-keybinds"></class>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="ContentContainer">
                <style>
                  <class name="content-container"></class>
                </style>
                <property name="orientation">horizontal</property>
                <!-- Natural height drives the window size here; letting this
                     expand instead collapses the grid to a couple of rows. -->
                <property name="vexpand">false</property>
                <property name="vexpand-set">true</property>
                <property name="valign">start</property>
                <child>
                  <object class="GtkLabel" id="ElephantHint">
                    <style>
                      <class name="elephant-hint"></class>
                    </style>
                    <property name="hexpand">true</property>
                    <property name="height-request">100</property>
                    <property name="label">Waiting for elephant...</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="Placeholder">
                    <style>
                      <class name="placeholder"></class>
                    </style>
                    <property name="label">No Results</property>
                    <property name="yalign">0.0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="Scroll">
                    <style>
                      <class name="scroll"></class>
                    </style>
                    <property name="hexpand">true</property>
                    <property name="can_focus">false</property>
                    <property name="overlay-scrolling">true</property>
                    <!-- Pin the grid width so the cell arithmetic is exact:
                         900 / 15 columns = 60px cell = 54px slot + 6px padding.
                         Without a fixed width the grid is wider than expected and
                         the cells spread out horizontally. -->
                    <property name="max-content-width">900</property>
                    <property name="min-content-width">900</property>
                    <property name="max-content-height">460</property>
                    <property name="min-content-height">0</property>
                    <property name="propagate-natural-height">true</property>
                    <property name="propagate-natural-width">false</property>
                    <property name="hscrollbar-policy">automatic</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <child>
                      <object class="GtkGridView" id="List">
                        <style>
                          <class name="list"></class>
                        </style>
                        <property name="max_columns">15</property>
                        <property name="can_focus">false</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>


            <child>
              <object class="GtkLabel" id="Error">
                <style>
                  <class name="error"></class>
                </style>
                <property name="xalign">0</property>
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
